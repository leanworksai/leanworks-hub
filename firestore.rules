rules_version = '2';
service cloud.firestore {
  // Helper function to get user email from auth token
  function getUserEmail() {
    return request.auth != null && request.auth.token.email != null 
      ? request.auth.token.email 
      : null;
  }
  
  // Helper to check if user is authenticated and has email
  function isAuthenticatedWithEmail() {
    return request.auth != null && getUserEmail() != null;
  }
  
  
  // Rules for default database
  match /databases/(default)/documents {
    // Organization-scoped collections
    match /orgs/{orgSlug} {

      // Messages collection - only for AI assistant chats
      match /messages/{messageId} {
        allow read: if request.auth != null && resource.data.chatId.startsWith('ai-assistant-');
        allow write: if request.auth != null && request.resource.data.chatId.startsWith('ai-assistant-');
      }

      // Updates collection
      match /updates/{updateId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }
  }
  
  // Rules for named database "leanworks-prod"
  match /databases/leanworks-prod/documents {
    // Organization-scoped collections
    match /orgs/{orgSlug} {

      // Messages collection - only for AI assistant chats
      match /messages/{messageId} {
        allow read: if request.auth != null && resource.data.chatId.startsWith('ai-assistant-');
        allow write: if request.auth != null && request.resource.data.chatId.startsWith('ai-assistant-');
      }

      // Updates collection
      match /updates/{updateId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
      
    }
  }
}

