## 5. Migration Plan for Existing Content

### 5.1 Current State Analysis

There are three categories of existing content:

1. **Already Converted**: HTML content with proper rich formatting (safe)
2. **Raw Markdown**: Content that should have been converted but wasn't (needs migration)
3. **Mixed/Flattened**: Content with partially converted or malformed structure (needs repair)

### 5.2 Migration Script

Create a migration script to run on the server:

```typescript
// scripts/migrate-markdown-content.ts

interface DocumentContent {
  id: string;
  content: string;
  updatedAt: Date;
}

async function migrateContent(doc: DocumentContent): Promise<DocumentContent> {
  // Step 1: Check if already converted
  const richTagCount = (doc.content.match(/<(h[1-6]|ul|ol|li|blockquote|pre|code)[^>]*>/gi) || []).length;
  
  if (richTagCount >= 3) {
    // Already has substantial HTML formatting - skip
    console.log(`[${doc.id}] Already converted, skipping`);
    return doc;
  }
  
  // Step 2: Check if it needs conversion
  const needsConversion = detectMarkdownConversionNeeded(doc.content);
  
  if (needsConversion.needsConversion) {
    console.log(`[${doc.id}] Converting markdown...`);
    const converted = convertMarkdownToHtml(doc.content);
    
    return {
      ...doc,
      content: converted,
      updatedAt: new Date(),
    };
  }
  
  return doc;
}

// Run migration for all documents
async function runMigration() {
  const documents = await fetchAllDocuments();
  
  for (const doc of documents) {
    try {
      const updated = await migrateContent(doc);
      if (updated.content !== doc.content) {
        await saveDocument(updated);
        console.log(`[${doc.id}] Migration complete`);
      }
    } catch (error) {
      console.error(`[${doc.id}] Migration failed:`, error);
    }
  }
}
```

