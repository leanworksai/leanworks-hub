#### 3.2.3 Simplify Paste Handler (Lines 485-535)

The paste handler should ONLY handle plain text markdown paste:

```typescript
paste: (view, event) => {
  const clipboardData = event.clipboardData;
  if (!clipboardData) return false;

  const text = clipboardData.getData('text/plain');
  const html = clipboardData.getData('text/html');

  // Priority 1: If HTML is available from rich text source, use it
  // This preserves formatting from other editors
  if (html && html.trim().length > 0) {
    // Check if HTML is already well-formatted rich content
    const richTagCount = (html.match(/<(h[1-6]|ul|ol|li|blockquote|pre|code|strong|em|b|i|a)[^>]*>/gi) || []).length;
    
    if (richTagCount >= 3) {
      return false; // Let default handler use the HTML
    }
  }

  // Priority 2: Convert plain text markdown if no good HTML
  if (text && text.trim().length > 0) {
    // Check if text is markdown using strict patterns
    const markdownPatterns = [
      /^#{1,6}\s/m,           // Headers at line start
      /^\s*[-*+]\s/m,         // Unordered lists at line start
      /^\s*\d+\.\s/m,         // Ordered lists at line start
      /^>\s/m,                // Blockquotes at line start
      /```[\s\S]*?```/m,       // Code blocks
    ];

    const isStrictMarkdown = markdownPatterns.some(pattern => pattern.test(text));

    if (isStrictMarkdown) {
      try {
        const htmlFromMarkdown = marked.parse(text, {
          breaks: false,
          gfm: true,
        }) as string;

        event.preventDefault();
        event.stopPropagation();
        
        if (editorRef.current) {
          editorRef.current.chain().focus().insertContent(htmlFromMarkdown).run();
          return true; // Handled
        }
      } catch (error) {
        console.warn('[RichTextEditor] Failed to parse markdown paste:', error);
      }
    }
  }

  return false; // Use default paste handler
},
```

#### 3.2.4 Remove Line Break Restoration from `convertMarkdownToHTML` (Line 246-275)

Simplify the function by removing the `restoreMarkdownLineBreaks` call:

```typescript
function convertMarkdownToHTML(markdown: string): string {
  try {
    // Extract text content if it's wrapped in HTML, preserving line breaks
    let textContent = markdown;
    if (markdown.includes('<')) {
      textContent = extractTextPreservingLineBreaks(markdown);
    }
    
    // REMOVED: The problematic flatten detection and line break restoration
    // This was causing the "partial convert then rollback" issue
    
    // Convert markdown to HTML with line break support
    return marked.parse(textContent, {
      breaks: true,  // Convert single newlines to <br>
      gfm: true,     // GitHub Flavored Markdown
    }) as string;
  } catch (error) {
    console.warn('Failed to convert markdown:', error);
    return markdown; // Return original if conversion fails
  }
}
```

